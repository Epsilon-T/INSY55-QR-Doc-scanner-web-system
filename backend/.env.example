# Copy this file to .env and fill in your own values
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qr_scanner_system

# Secret used to turn student numbers into the QR value (hashedID). Never change it after
# QR codes are printed, or every printed QR code stops working.
QR_SECRET_KEY=change-me

# Secret used to sign login tokens and COR image links
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=480

# Decides what "today" means for the daily logs
APP_TIMEZONE=Asia/Manila
